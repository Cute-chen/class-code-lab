DATABASE_DSN=sqlite://./class-code-lab.db
# MySQL 可改为：root:1234@tcp(127.0.0.1:3306)/class_code_lab?charset=utf8mb4&parseTime=True&loc=Local
APP_ADDRESS=:8080
RUNNER_ADDRESS=:8081
FRONTEND_DIST=../frontend/dist
COOKIE_SECURE=false
SESSION_HOURS=10
RUN_TOKEN_MINUTES=5

ADMIN_NAME=任课教师
ADMIN_LOGIN=teacher
ADMIN_PASSWORD=123456

# AI 服务及全局默认设置请登录教师后台，在“AI 对话与用量”中管理。
# 旧版 AI_* 环境变量仅在数据库首次初始化时导入一次。
